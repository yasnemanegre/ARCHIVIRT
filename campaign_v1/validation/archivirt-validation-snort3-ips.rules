# ARCHIVIRT — VALIDATION ruleset for Snort 3.1.74.0 (IPS, NFQUEUE, -Q). Same markers, action "drop".
# HTTP marker: action "block" (current packet AND the rest of the flow). With "drop" (packet only), the TCP
# retransmission of the request was not re-inspected and the server answered 200 (observed 2026-10-20, run 1).
block http $EXTERNAL_NET any -> $HOME_NET any (msg:"ARCHIVIRT VALIDATION canary user-agent (snort3 block)"; flow:established,to_server; http_header:field user-agent; content:"ARCHIVIRT-VALIDATION-CANARY-7f3a"; sid:9200011; rev:2;)
drop icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"ARCHIVIRT VALIDATION canary icmp payload (snort3 drop)"; itype:8; content:"ARCHIVIRT-ICMP-CANARY"; sid:9200012; rev:1;)
