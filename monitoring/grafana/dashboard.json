{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "influxdb", "name": "InfluxDB", "version": "1.0.0"},
    {"type": "panel", "id": "gauge", "name": "Gauge", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""}
  ],
  "title": "ARCHIVIRT — IDS/IPS Testing Dashboard",
  "uid": "archivirt-main",
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Monitor VM CPU %",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "influxdb", "uid": "archivirt-influx"},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 10}, {"color": "red", "value": 50}]}, "color": {"mode": "thresholds"}}},
      "targets": [{"datasource": {"type": "influxdb", "uid": "archivirt-influx"}, "query": "from(bucket: \"archivirt\") |> range(start: -5m) |> filter(fn: (r) => r[\"_measurement\"] == \"cpu\" and r[\"_field\"] == \"usage_user\" and r[\"host\"] == \"archivirt-monitor-ids\") |> last()", "refId": "A"}]
    },
    {
      "id": 2, "type": "stat", "title": "Monitor VM RAM MB",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "influxdb", "uid": "archivirt-influx"},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "decmbytes", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 500}, {"color": "red", "value": 1500}]}, "color": {"mode": "thresholds"}}},
      "targets": [{"datasource": {"type": "influxdb", "uid": "archivirt-influx"}, "query": "from(bucket: \"archivirt\") |> range(start: -5m) |> filter(fn: (r) => r[\"_measurement\"] == \"mem\" and r[\"_field\"] == \"used\" and r[\"host\"] == \"archivirt-monitor-ids\") |> map(fn: (r) => ({r with _value: r._value / 1048576})) |> last()", "refId": "A"}]
    },
    {
      "id": 3, "type": "stat", "title": "Suricata Total Alerts",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "influxdb", "uid": "archivirt-influx"},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 100}, {"color": "red", "value": 1000}]}, "color": {"mode": "thresholds"}}},
      "targets": [{"datasource": {"type": "influxdb", "uid": "archivirt-influx"}, "query": "from(bucket: \"archivirt\") |> range(start: -1h) |> filter(fn: (r) => r[\"_measurement\"] == \"archivirt_suricata_alerts\") |> last()", "refId": "A"}]
    },
    {
      "id": 4, "type": "stat", "title": "Snort Total Alerts",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "influxdb", "uid": "archivirt-influx"},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 100}, {"color": "red", "value": 1000}]}, "color": {"mode": "thresholds"}}},
      "targets": [{"datasource": {"type": "influxdb", "uid": "archivirt-influx"}, "query": "from(bucket: \"archivirt\") |> range(start: -1h) |> filter(fn: (r) => r[\"_measurement\"] == \"archivirt_snort_alerts\") |> last()", "refId": "A"}]
    },
    {
      "id": 5, "type": "stat", "title": "Snort Process CPU %",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 4},
      "datasource": {"type": "influxdb", "uid": "archivirt-influx"},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]}, "color": {"mode": "thresholds"}}},
      "targets": [{"datasource": {"type": "influxdb", "uid": "archivirt-influx"}, "query": "from(bucket: \"archivirt\") |> range(start: -5m) |> filter(fn: (r) => r[\"_measurement\"] == \"procstat\" and r[\"_field\"] == \"cpu_usage\" and r[\"pattern\"] == \"snort\") |> last()", "refId": "A"}]
    },
    {
      "id": 6, "type": "stat", "title": "Snort Process RAM MB",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 4},
      "datasource": {"type": "influxdb", "uid": "archivirt-influx"},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "decmbytes", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 100}, {"color": "red", "value": 500}]}, "color": {"mode": "thresholds"}}},
      "targets": [{"datasource": {"type": "influxdb", "uid": "archivirt-influx"}, "query": "from(bucket: \"archivirt\") |> range(start: -5m) |> filter(fn: (r) => r[\"_measurement\"] == \"procstat\" and r[\"_field\"] == \"memory_rss\" and r[\"pattern\"] == \"snort\") |> map(fn: (r) => ({r with _value: r._value / 1048576})) |> last()", "refId": "A"}]
    },
    {
      "id": 7, "type": "stat", "title": "Suricata Process CPU %",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 4},
      "datasource": {"type": "influxdb", "uid": "archivirt-influx"},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 10}, {"color": "red", "value": 30}]}, "color": {"mode": "thresholds"}}},
      "targets": [{"datasource": {"type": "influxdb", "uid": "archivirt-influx"}, "query": "from(bucket: \"archivirt\") |> range(start: -5m) |> filter(fn: (r) => r[\"_measurement\"] == \"procstat\" and r[\"_field\"] == \"cpu_usage\" and r[\"pattern\"] == \"suricata\") |> last()", "refId": "A"}]
    },
    {
      "id": 8, "type": "stat", "title": "Suricata Process RAM MB",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 4},
      "datasource": {"type": "influxdb", "uid": "archivirt-influx"},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "decmbytes", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 100}, {"color": "red", "value": 500}]}, "color": {"mode": "thresholds"}}},
      "targets": [{"datasource": {"type": "influxdb", "uid": "archivirt-influx"}, "query": "from(bucket: \"archivirt\") |> range(start: -5m) |> filter(fn: (r) => r[\"_measurement\"] == \"procstat\" and r[\"_field\"] == \"memory_rss\" and r[\"pattern\"] == \"suricata\") |> map(fn: (r) => ({r with _value: r._value / 1048576})) |> last()", "refId": "A"}]
    },
    {
      "id": 9, "type": "timeseries", "title": "CPU Usage — Monitor VM",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "influxdb", "uid": "archivirt-influx"},
      "fieldConfig": {"defaults": {"unit": "percent", "color": {"mode": "palette-classic"}}},
      "targets": [{"datasource": {"type": "influxdb", "uid": "archivirt-influx"}, "query": "from(bucket: \"archivirt\") |> range(start: -30m) |> filter(fn: (r) => r[\"_measurement\"] == \"cpu\" and r[\"_field\"] == \"usage_user\" and r[\"cpu\"] == \"cpu-total\") |> aggregateWindow(every: 10s, fn: mean)", "refId": "A"}]
    },
    {
      "id": 10, "type": "timeseries", "title": "IDS Alerts Over Time",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "influxdb", "uid": "archivirt-influx"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}},
      "targets": [{"datasource": {"type": "influxdb", "uid": "archivirt-influx"}, "query": "from(bucket: \"archivirt\") |> range(start: -1h) |> filter(fn: (r) => r[\"_measurement\"] == \"archivirt_suricata_alerts\" or r[\"_measurement\"] == \"archivirt_snort_alerts\") |> aggregateWindow(every: 30s, fn: last)", "refId": "A"}]
    },
    {
      "id": 11, "type": "timeseries", "title": "Network Throughput — Monitor VM (bytes/s)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "influxdb", "uid": "archivirt-influx"},
      "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}}},
      "targets": [{"datasource": {"type": "influxdb", "uid": "archivirt-influx"}, "query": "from(bucket: \"archivirt\") |> range(start: -30m) |> filter(fn: (r) => r[\"_measurement\"] == \"net\" and (r[\"_field\"] == \"bytes_recv\" or r[\"_field\"] == \"bytes_sent\") and r[\"host\"] == \"archivirt-monitor-ids\") |> derivative(unit: 1s, nonNegative: true) |> aggregateWindow(every: 10s, fn: mean)", "refId": "A"}]
    }
  ],
  "schemaVersion": 36,
  "version": 2
}
