*.json
!monitoring/grafana/dashboard.json
!results/*.json
!results/campaigns/*.json
reports/
*.html
*.pcap
*.csv
# SSH Keys
*.pem
*.key
*_key
*_key.pub
!configs/
# Logs
logs/
*.log
# OS
.DS_Store
Thumbs.db
