*.swo
# Ansible retry files
ansible/*.retry
suricata_eve_*.json
packages/
*.bak.*
# Terraform state — environment-specific, never commit
*.deb
*.run
*.tfvars
*.bak
ansible/vars/secrets.yml
terraform/terraform.tfvars

# Transient campaign_v1 iteration backups
*.bak-*

# campaign_v1 engine config/schema/manifest (JSON must be tracked)
!campaign_v1/**/*.json

# --- Article 2 scientific dataset -------------------------------------------
# The *.json / *.csv rules above are global; re-include the Article-2 records
# and deliverables so metric traceability/reproducibility is committed.
!results/campaign-v1/
!results/campaign-v1/**/*.json
!results/campaign-v1/**/*.csv
# ...but keep the bulky packet-level raw evidence OUT of git (retained locally,
# referenced from RESULTS.md). These re-exclusions must follow the negations.
results/campaign-v1/**/eve.json
results/campaign-v1/**/*_raw.txt

# --- Offline remediation 2026-10-17 -----------------------------------------
# Real ansible-vault file (secrets) is never committed; the template is.
ansible/inventory/group_vars/all/vault.yml
# Terraform provider lock file must be tracked (pins dmacvicar/libvirt + hashes)
!terraform/.terraform.lock.hcl
# Disposable offline-rebuild validation environment (separate state, never committed)
terraform/validation/.terraform/
terraform/validation/terraform.tfstate*
terraform/validation/*.tfplan
